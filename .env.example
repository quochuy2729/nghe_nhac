# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.
# Để trống thì app tự dùng mock provider / chế độ khách (không đồng bộ).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Jamendo → https://devportal.jamendo.com → My Applications → Client ID
VITE_JAMENDO_CLIENT_ID=

# Tùy chọn: base path khi build (mặc định "/" local, "/nghe_nhac/" trên GitHub Actions)
# VITE_BASE=/nghe_nhac/
